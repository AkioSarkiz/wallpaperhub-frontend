{
    "name": "wallpaper-frontend",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "forwardPorts": [3000],
    "portsAttributes": {
        "3000": {
            "label": "Next.js dev server",
            "onAutoForward": "notify"
        }
    },
    "remoteUser": "node",
    "containerEnv": {
        "NEXT_TELEMETRY_DISABLED": "1"
    },
    "mounts": [
        "source=wallpaper-frontend-node_modules,target=/workspace/node_modules,type=volume",
        "source=wallpaper-frontend-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume"
    ],
    "postCreateCommand": "sudo chown -R node:node /workspace/node_modules /home/node/.local/share/pnpm/store && corepack enable && corepack prepare pnpm@latest --activate && pnpm install",
    "postAttachCommand": "pnpm dev",
    "customizations": {
        "vscode": {
            "extensions": [
                "biomejs.biome",
                "bradlc.vscode-tailwindcss",
                "dbaeumer.vscode-eslint",
                "ms-azuretools.vscode-docker",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "biomejs.biome",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    }
}
